# Copy to .env and fill in. Never commit .env or the service-account JSON.
OPENAQ_API_KEY=            # free — explore.openaq.org account settings
FIRMS_MAP_KEY=             # free — firms.modaps.eosdis.nasa.gov/api
GEE_SERVICE_ACCOUNT_JSON=  # filename of the GEE service-account key JSON (in repo root, gitignored)
GEE_PROJECT_ID=            # Google Cloud project registered for Earth Engine
WAQI_TOKEN=                # optional — current conditions only, not used by the core pipeline
